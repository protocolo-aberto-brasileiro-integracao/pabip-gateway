# Config precedence is Admin API > ENV > config file > default.
# Everything below is the ENV leg of that chain for fields that don't ship
# with a usable default — see src/config/config.constants.ts for the full
# field table (every field, its ENV var, and whether it has a default).
# Fields with a default aren't listed here; set them only to override.

# Prisma connection string for the gateway's own registry (peers, config,
# admin tokens, audit log) — `database.url`, bootOnly. Matches the local
# Postgres service in docker-compose.dev.yml — run
# `docker compose -f docker-compose.dev.yml up` and this value works as-is.
# Supports the DATABASE_URL_FILE convention (Docker/K8s secret files) since
# this field is `sensitive` in config.constants.ts.
DATABASE_URL="postgresql://gateway:gateway@localhost:5432/gateway?schema=public"

# `gateway.entePublicoName`, bootOnly, no default — identity of the operator
# running this instance, fixed at install time. The process refuses to
# finish booting without it.
GATEWAY_ENTE_PUBLICO_NAME="local-dev"

# Set to "true" to allow `database.url` to point at SQLite (`file:...`)
# instead of Postgres — `gateway.devMode`, bootOnly, default false. Never
# set this in production.
# GATEWAY_DEV_MODE=false

# Path to the config file that seeds file-sourced values.
# Optional — a missing file just means every field falls through to
# ENV/default.
# GATEWAY_CONFIG_FILE=gateway.config.yaml

# Forces file/ENV to win again over any value already set via the Admin API
# for this one boot. Off by default; an explicit operator action, not
# something left set long-term.
# GATEWAY_CONFIG_RESEED=false

# Seeds the first admin-api token(s) on first boot (`gateway.adminTokens`)
# — comma-separated, no ENV array syntax. Only ever a seed: once at least
# one token exists in the database, further token management is via
# `admin-api` (`POST`/`DELETE /admin/tokens`), never this variable again.
# The gateway refuses to finish booting if this is empty/unset *and* no
# admin token exists in the database yet (fail-closed) — set this on first
# install, or run `pabip-gatewayctl` against another instance that already
# has one to issue a fresh token instead.
# GATEWAY_ADMIN_TOKENS=adm_replace-me-with-a-real-generated-token

# `gateway.publicPort`/`gateway.adminPort` — the two listeners `main.ts`
# binds, always on different ports. Defaults below (8080/8081) already
# match the Dockerfile's EXPOSE — override only if something else on the
# host already holds them.
# GATEWAY_PUBLIC_PORT=8080
# GATEWAY_ADMIN_PORT=8081

# Comma-separated CIDR/IP list of the reverse proxy(ies) in front of the
# public listener. Empty (default) trusts exactly one hop, which already
# matches this repo's reference single-reverse-proxy topology
# (`app.set('trust proxy', 1)`) — set this only for a topology with more
# than one proxy in front, or to scope trust to specific proxy addresses.
# GATEWAY_TRUSTED_PROXY_CIDRS=10.0.0.0/24

# `egress.requireHttps`, default true — require HTTPS for all outbound calls
# to peer baseUrls (onboarding manifest check, SDK clients). Never disable in
# production; only useful for local HTTP-only peers in dev.
# GATEWAY_EGRESS_REQUIRE_HTTPS=true

# `egress.allowPrivateDestinations`, default false — when false, peer
# baseUrls that resolve (DNS or literal IP) to a loopback, private,
# link-local or cloud-metadata address are rejected (SSRF guard). Set to
# "true" only in local/dev to onboard a peer running on localhost/a private
# network.
# GATEWAY_EGRESS_ALLOW_PRIVATE=false

# `security.secretEncryptionKey`, bootOnly, default "" (unset) — AES-256-GCM
# key used to encrypt peer.theirApiKey at rest. Must decode to exactly 32
# bytes, as base64 or hex — generate one with `openssl rand -base64 32`.
# Unset means peer upstream API keys are stored in plaintext (a warning is
# logged once at startup). Existing plaintext rows keep reading back fine
# once this is set (legacy passthrough) — only decrypting a row that was
# encrypted under a *different* key than the one currently set will fail.
# GATEWAY_SECRET_ENCRYPTION_KEY=

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Set to "production" to emit plain structured JSON log lines instead of the
# pretty-printed dev format (see src/common/logging/pino-logger.service.ts).
NODE_ENV=development
